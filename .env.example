# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/siteguard?schema=public"

# Claude API key, used only to turn already-collected scan results into a
# human-readable report. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the Claude model used for report generation.
ANTHROPIC_MODEL="claude-sonnet-5"
