# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/siteguard?schema=public"

# Tilvar API key, used only to turn already-collected scan results into a
# human-readable report. Tilvar is a self-hosted translation/chat model at
# https://tilvar.athena.org.tr -- ask for a key on the Athena account used to
# run this deployment.
TAMARIX_TILVAR_API_KEY="..."

# Optional. Tilvar rejects requests over this many characters (HTTP 413).
# Only used as a known limit for the Tilvar API; defaults to 8000 if unset.
TAMARIX_TILVAR_API_MAX_CHARS=8000
